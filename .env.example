# Copy to .env and fill. Never commit .env.

OPENAI_API_KEY=

# Primary model (Responses API)
LLM_MODEL=gpt-6-luna
LLM_BASE_URL=https://api.openai.com/v1
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.0

# Reserved. v1 main loop does not use these.
